{
    "luci-app-antiblock": {
        "description": "Grant UCI and RPC access to LuCI app AntiBlock",
        "read": {
            "file": {
                "/tmp/antiblock/*": [
                    "read"
                ],
                "/etc/antiblock/*": [
                    "read"
                ]
            },
            "uci": [
                "antiblock"
            ]
        },
        "write": {
            "file": {
                "/etc/antiblock/*": [
                    "write"
                ],
                "/etc/init.d/antiblock restart": [
                    "exec"
                ],
                "/bin/mkdir -p /etc/antiblock": [
                    "exec"
                ]
            },
            "uci": [
                "antiblock"
            ]
        }
    }
}
